# Пример config/.env. Pulse-PC создаёт и заполняет этот файл сам (Настройки → Telegram Бот).
# Токен бота хранится не здесь, а зашифрованным в config/secrets.bin (DPAPI Windows);
# в этом файле для него остаётся заглушка.
BOT_TOKEN=your_telegram_bot_token_here
# Ваш числовой Telegram ID (бот подскажет его в ответ на /start)
ADMIN_ID=
